{
  "name": "ACF",
  "servePort": 34877,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "ACFShared": {
        "$path": "src/Shared"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "ACFTelemetry": {
          "$path": "src/Client/ClientTelemetry.client.luau"
        }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "ACF": {
        "$path": "src/Server"
      }
    }
  }
}
